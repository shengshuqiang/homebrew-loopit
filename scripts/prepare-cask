#!/usr/bin/python3
"""Generate the Homebrew cask from a release ZIP that passes macOS distribution checks."""

import hashlib
import json
import os
from pathlib import Path
import plistlib
import re
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
APP = "Loopit Game Playground.app"
BUNDLE_ID = "me.loopit.game.playground"


def prepare(archive):
    with tempfile.TemporaryDirectory(prefix="loopit-cask-") as scratch:
        snapshot = Path(scratch) / "release.zip"
        digest = hashlib.sha256()
        with archive.open("rb") as source, snapshot.open("xb") as copy:
            for block in iter(lambda: source.read(1024 * 1024), b""):
                copy.write(block)
                digest.update(block)
        extracted = Path(scratch) / "bundle"
        extracted.mkdir()
        bundle = extracted / APP
        subprocess.run(["/usr/bin/ditto", "-x", "-k", str(snapshot), str(extracted)], check=True)
        with (bundle / "Contents/Info.plist").open("rb") as plist:
            info = plistlib.load(plist)
        version = info["CFBundleShortVersionString"]
        build = info["CFBundleVersion"]
        if info["CFBundleIdentifier"] != BUNDLE_ID or not (
            re.fullmatch(r"[0-9]+(?:\.[0-9]+){1,3}", version) and re.fullmatch(r"[0-9]+", build)
        ):
            raise ValueError("应用标识或版本与 Playground 的发行格式不符")
        metadata = json.loads((bundle / "Contents/Resources/playground-release.json").read_text())
        if (metadata["version"], str(metadata["build"])) != (version, build):
            raise ValueError("应用版本与内置发行信息不一致")
        executable = bundle / "Contents/MacOS" / info["CFBundleExecutable"]
        subprocess.run(["/usr/bin/lipo", str(executable), "-verify_arch", "arm64"], check=True)
        subprocess.run(["/usr/bin/codesign", "--verify", "--deep", "--strict", str(bundle)], check=True)
        subprocess.run(["/usr/bin/syspolicy_check", "distribution", str(bundle)], check=True)
        subprocess.run(["/usr/sbin/spctl", "--assess", "--type", "execute", str(bundle)], check=True)

    cask = (ROOT / "templates/loopit-game-playground.rb.in").read_text()
    cask = cask.replace("@VERSION@", version).replace("@BUILD@", build).replace("@SHA256@", digest.hexdigest())
    target = ROOT / "Casks/loopit-game-playground.rb"
    target.parent.mkdir(exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=target.parent, mode="w", delete=False) as generated:
        generated.write(cask)
    os.replace(generated.name, target)
    print(f"生成 {target.name}，版本 {version}，构建 {build}，SHA-256 {digest.hexdigest()}")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("用法：scripts/prepare-cask <Playground发行ZIP>")
    try:
        prepare(Path(sys.argv[1]).resolve(strict=True))
    except (OSError, KeyError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(f"未生成安装配方：{error}")
