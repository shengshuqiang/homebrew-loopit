  url "https://github.com/shengshuqiang/homebrew-loopit/releases/download/v#{version.csv.first}-#{version.csv.second}/Loopit-Game-Playground-#{version.csv.first}-#{version.csv.second}-arm64.zip"
  name "Loopit Game Playground"
